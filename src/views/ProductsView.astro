---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const products = await getCollection('products');

// Group unique categories
const categories = ['all', ...new Set(products.map((p) => p.data.category || 'General Commodity'))];
---

<BaseLayout
  title={t.products.title}
  description={t.products.subtitle}
  lang={lang}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-brand-950 to-brand-900 text-white py-14 lg:py-20 border-b border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400 block mb-2">
          {t.products.badge}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white font-['Plus_Jakarta_Sans',sans-serif] mb-4">
          {t.products.title}
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          {t.products.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Search & Filter Controls -->
  <section class="bg-white border-b border-slate-200 py-6 sticky top-20 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        
        <!-- Keyword Search Input -->
        <div class="relative flex-1 max-w-lg">
          <label for="commodity-search" class="sr-only">Search commodities</label>
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="search"
            id="commodity-search"
            placeholder={t.products.searchPlaceholder}
            class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 text-sm placeholder-slate-400 transition-colors bg-slate-50 focus:bg-white"
          />
        </div>

        <!-- Category Filter Pills -->
        <div class="flex items-center overflow-x-auto pb-1 md:pb-0 gap-2 scrollbar-none" id="category-pills">
          <button
            type="button"
            data-filter="all"
            class="filter-pill px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-700 text-white shadow-xs whitespace-nowrap active"
          >
            {t.products.filterAll}
          </button>
          {categories.filter(c => c !== 'all').map((cat) => (
            <button
              type="button"
              data-filter={cat}
              class="filter-pill px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 transition-all whitespace-nowrap"
            >
              {cat}
            </button>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Commodity Grid Section -->
  <section class="py-12 lg:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product) => {
        const productUrl = getLocalizedPath(`/products/${product.slug}`, lang);
        const rfqUrl = getLocalizedPath(`/rfq?product=${product.slug}`, lang);
        const searchCorpus = `${product.data.title} ${product.data.hsCode} ${product.data.originCountry} ${product.data.grade} ${product.data.category || ''}`.toLowerCase();

        return (
          <article
            class="product-card bg-white rounded-2xl border border-slate-200 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group"
            data-category={product.data.category || 'General Commodity'}
            data-search={searchCorpus}
          >
            <!-- Card Image -->
            <div class="relative h-60 overflow-hidden bg-slate-100">
              <img
                src={product.data.featuredImage}
                alt={product.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 left-3 bg-slate-950/85 backdrop-blur-xs text-white text-xs font-semibold px-2.5 py-1 rounded-md">
                HS {product.data.hsCode}
              </div>
              <div class="absolute top-3 right-3 bg-brand-600 text-white text-xs font-bold px-2.5 py-1 rounded-md shadow-xs">
                {product.data.originCountry}
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-600">
                    {product.data.category || 'Commodity'}
                  </span>
                  <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                    SGS Inspected
                  </span>
                </div>

                <h2 class="text-xl font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] group-hover:text-brand-700 transition-colors">
                  <a href={productUrl}>{product.data.title}</a>
                </h2>

                <p class="text-xs text-slate-500 mt-2.5 line-clamp-2 leading-relaxed">
                  {product.data.metaDescription}
                </p>

                <!-- Spec List -->
                <div class="mt-4 pt-4 border-t border-slate-100 space-y-2 text-xs">
                  <div class="flex justify-between items-baseline">
                    <span class="text-slate-400 font-medium">{t.products.gradeLabel}:</span>
                    <span class="font-semibold text-slate-800 text-right">{product.data.grade}</span>
                  </div>
                  <div class="flex justify-between items-baseline">
                    <span class="text-slate-400 font-medium">{t.products.moqLabel}:</span>
                    <span class="font-semibold text-slate-800 text-right">{product.data.moq}</span>
                  </div>
                  <div class="flex justify-between items-baseline">
                    <span class="text-slate-400 font-medium">{t.products.portsLabel}:</span>
                    <span class="font-semibold text-slate-800 text-right line-clamp-1">{product.data.loadingPorts.join(', ')}</span>
                  </div>
                </div>

                <!-- Incoterms tags -->
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {product.data.incoterms.map((incoterm) => (
                    <span class="bg-slate-100 text-slate-700 text-[10px] font-semibold px-2 py-0.5 rounded border border-slate-200/60">
                      {incoterm}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Card Action Buttons -->
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-3">
                <a
                  href={productUrl}
                  class="flex-1 text-center py-2.5 px-3 rounded-lg text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 hover:text-slate-900 transition-colors"
                >
                  {t.products.viewSpecs}
                </a>
                <a
                  href={rfqUrl}
                  class="flex-1 text-center py-2.5 px-3 rounded-lg text-xs font-bold text-white bg-brand-700 hover:bg-brand-800 shadow-xs transition-colors flex items-center justify-center"
                >
                  <span>RFQ</span>
                  <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- No Results State -->
    <div id="no-results" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 p-8 max-w-md mx-auto">
      <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-800">{t.products.noResults}</h3>
      <p class="text-xs text-slate-500 mt-1">Try resetting your search query or selecting "All Categories".</p>
    </div>
  </section>
</BaseLayout>

<script>
  function setupProductFilters() {
    const searchInput = document.getElementById('commodity-search') as HTMLInputElement | null;
    const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.product-card');
    const noResults = document.getElementById('no-results');

    let currentCategory = 'all';
    let currentQuery = '';

    function filterGrid() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category') || '';
        const cardSearch = card.getAttribute('data-search') || '';

        const matchesCat = currentCategory === 'all' || cardCat === currentCategory;
        const matchesQuery = !currentQuery || cardSearch.includes(currentQuery);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        filterGrid();
      });
    }

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach((p) => {
          p.classList.remove('bg-brand-700', 'text-white', 'shadow-xs', 'active');
          p.classList.add('text-slate-600', 'bg-slate-100');
        });
        pill.classList.remove('text-slate-600', 'bg-slate-100');
        pill.classList.add('bg-brand-700', 'text-white', 'shadow-xs', 'active');

        currentCategory = pill.getAttribute('data-filter') || 'all';
        filterGrid();
      });
    });
  }

  setupProductFilters();
  document.addEventListener('astro:after-swap', setupProductFilters);
</script>
