---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allProducts = await getCollection('products');
// Display top commodities
const featuredProducts = allProducts.slice(0, 6);
---

<BaseLayout
  title={t.hero.headline1}
  description={t.aboutTagline.subtitle}
  lang={lang}
>
  <!-- Hero Section (Horizon Exim Signature Rounded Luxury Card) -->
  <section class="py-4 sm:py-6">
    <div class="max-w-[1440px] mx-auto px-2 sm:px-4 lg:px-6">
      <div class="relative rounded-3xl sm:rounded-4xl overflow-hidden bg-gradient-to-br from-brand-600 via-brand-800 to-brand-950 text-white py-16 sm:py-24 lg:py-28 px-6 sm:px-12 lg:px-16 shadow-2xl border border-brand-700/50">
        
        <!-- Background Imagery & Ambient Lighting -->
        <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#60a5fa_1px,transparent_1px)] [background-size:24px_24px]"></div>
        <div class="absolute -right-20 -bottom-20 w-[500px] h-[500px] bg-brand-400/20 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-20 -top-20 w-[400px] h-[400px] bg-amber-400/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-4xl">
          <!-- Trust Badge Pill -->
          <div class="inline-flex items-center space-x-2.5 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 text-xs font-bold text-amber-300 mb-6 backdrop-blur-md shadow-xs">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>{t.hero.badge}</span>
          </div>

          <!-- Dynamic Hero Headlines Carousel / Slider Content -->
          <div id="hero-slider" class="min-h-[220px] sm:min-h-[200px]">
            <!-- Slide 1: Rice Exporter Solutions -->
            <div class="hero-slide transition-opacity duration-500">
              <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] text-white font-['Plus_Jakarta_Sans',sans-serif] mb-5">
                {t.hero.headline1}
              </h1>
              <p class="text-base sm:text-xl text-slate-200 leading-relaxed max-w-2xl">
                {t.hero.sub1}
              </p>
            </div>
            
            <!-- Slide 2: India's Top Onion Exporter -->
            <div class="hero-slide hidden transition-opacity duration-500">
              <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] text-white font-['Plus_Jakarta_Sans',sans-serif] mb-5">
                {t.hero.headline2}
              </h1>
              <p class="text-base sm:text-xl text-slate-200 leading-relaxed max-w-2xl">
                {t.hero.sub2}
              </p>
            </div>

            <!-- Slide 3: Fresh Mango Specialists -->
            <div class="hero-slide hidden transition-opacity duration-500">
              <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] text-white font-['Plus_Jakarta_Sans',sans-serif] mb-5">
                {t.hero.headline3}
              </h1>
              <p class="text-base sm:text-xl text-slate-200 leading-relaxed max-w-2xl">
                {t.hero.sub3}
              </p>
            </div>
          </div>

          <!-- Slider Dot Controls -->
          <div class="flex items-center space-x-2 my-8">
            <button class="slide-indicator w-8 h-2 rounded-full bg-amber-400 transition-all duration-300" aria-label="Slide 1"></button>
            <button class="slide-indicator w-2.5 h-2 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" aria-label="Slide 2"></button>
            <button class="slide-indicator w-2.5 h-2 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300" aria-label="Slide 3"></button>
          </div>

          <!-- Hero CTAs (Horizon Exim Style) -->
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a
              href={getLocalizedPath('/products', lang)}
              class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-slate-950 bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 hover:to-amber-200 shadow-xl shadow-amber-950/30 transition-all duration-200 hover:-translate-y-0.5"
            >
              <span>{t.hero.viewProducts}</span>
              <svg class="w-5 h-5 ml-2 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <a
              href={getLocalizedPath('/rfq', lang)}
              class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-white bg-white/10 hover:bg-white/20 border border-white/25 backdrop-blur-md transition-all duration-200 hover:-translate-y-0.5"
            >
              <span>{t.hero.requestQuote}</span>
            </a>
          </div>
        </div>

        <!-- Metric Counter Strip at Hero Footer (Horizon Exim Style) -->
        <div class="mt-14 pt-8 border-t border-white/15 grid grid-cols-2 md:grid-cols-4 gap-6">
          <div class="p-3">
            <div class="text-3xl sm:text-4xl font-black text-amber-300 font-['Plus_Jakarta_Sans',sans-serif]">45+</div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1 font-semibold">{t.hero.stats.countries}</div>
          </div>
          <div class="p-3">
            <div class="text-3xl sm:text-4xl font-black text-white font-['Plus_Jakarta_Sans',sans-serif]">250K+</div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1 font-semibold">{t.hero.stats.volume}</div>
          </div>
          <div class="p-3">
            <div class="text-3xl sm:text-4xl font-black text-emerald-400 font-['Plus_Jakarta_Sans',sans-serif]">1,200+</div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1 font-semibold">{t.hero.stats.shipments}</div>
          </div>
          <div class="p-3">
            <div class="text-3xl sm:text-4xl font-black text-amber-300 font-['Plus_Jakarta_Sans',sans-serif]">&lt; 24h</div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1 font-semibold">{t.hero.stats.turnaround}</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- About / Brand Statement Section (Horizon Exim Signature Tagline) -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Side: Copy and 3 Trust Feature Blocks -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-3.5 py-1.5 rounded-full border border-brand-200">
            <span>Horizon Exim Philosophy</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] leading-tight">
            {t.aboutTagline.lead}
          </h2>

          <p class="text-base text-slate-600 leading-relaxed">
            {t.aboutTagline.subtitle}
          </p>

          <!-- 3 Feature Pillars -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
              </div>
              <h3 class="text-sm font-bold text-slate-900 mb-1">{t.aboutTagline.feature1Title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{t.aboutTagline.feature1Desc}</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-sm font-bold text-slate-900 mb-1">{t.aboutTagline.feature2Title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{t.aboutTagline.feature2Desc}</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
              <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <h3 class="text-sm font-bold text-slate-900 mb-1">{t.aboutTagline.feature3Title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{t.aboutTagline.feature3Desc}</p>
            </div>
          </div>
        </div>

        <!-- Right Side: Real Farm-to-Port Visual -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200 group">
            <img
              src="https://images.unsplash.com/photo-1595246140625-573b715d11dc?auto=format&fit=crop&w=1200&q=80"
              alt="Indian agricultural harvest and packaging facility"
              class="w-full h-[460px] object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent flex flex-col justify-end p-8 text-white">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-300 mb-1">
                Farm Gate Sourcing
              </span>
              <h3 class="text-xl font-bold font-['Plus_Jakarta_Sans',sans-serif]">
                Nashik, Punjab &amp; Gujarat Terminals
              </h3>
              <p class="text-xs text-slate-300 mt-1">
                Direct export dispatch from Mundra, Nhava Sheva (JNPT), and Kandla ports.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- "Our Products" Showcase Grid (Horizon Exim Style with Up-Right Arrows) -->
  <section class="py-16 lg:py-24 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-600 block mb-2">
            {t.products.badge}
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-['Plus_Jakarta_Sans',sans-serif]">
            {t.products.title}
          </h2>
          <p class="text-base text-slate-600 mt-2 max-w-2xl">
            {t.products.subtitle}
          </p>
        </div>
        <div class="mt-4 md:mt-0">
          <a
            href={getLocalizedPath('/products', lang)}
            class="inline-flex items-center text-sm font-bold text-brand-600 hover:text-brand-800 group"
          >
            <span>{t.hero.viewProducts}</span>
            <span class="ml-2 w-7 h-7 rounded-full bg-brand-50 flex items-center justify-center text-brand-600 group-hover:bg-brand-600 group-hover:text-white transition-all">
              ↗
            </span>
          </a>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredProducts.map((product) => {
          const productUrl = getLocalizedPath(`/products/${product.slug}`, lang);
          const rfqUrl = getLocalizedPath(`/rfq?product=${product.slug}`, lang);

          return (
            <article class="bg-white rounded-3xl border border-slate-200 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group">
              <!-- Product Image -->
              <div class="relative h-64 overflow-hidden bg-slate-900">
                <img
                  src={product.data.featuredImage}
                  alt={product.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 bg-slate-950/85 backdrop-blur-xs text-white text-xs font-bold px-3 py-1 rounded-lg">
                  HS {product.data.hsCode}
                </div>
                <div class="absolute top-4 right-4 bg-brand-600 text-white text-xs font-bold px-3 py-1 rounded-lg shadow-sm">
                  {product.data.originCountry}
                </div>
              </div>

              <!-- Product Card Body -->
              <div class="p-6 flex-grow flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-brand-600">
                      {product.data.category || 'Agro Commodity'}
                    </span>
                    <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                      Export Ready
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] group-hover:text-brand-600 transition-colors">
                    <a href={productUrl}>{product.data.title}</a>
                  </h3>

                  <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                    {product.data.metaDescription}
                  </p>

                  <!-- Technical Highlights -->
                  <div class="mt-4 pt-4 border-t border-slate-100 space-y-1.5 text-xs">
                    <div class="flex justify-between">
                      <span class="text-slate-400">{t.products.gradeLabel}:</span>
                      <span class="font-semibold text-slate-800 text-right line-clamp-1">{product.data.grade}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">{t.products.moqLabel}:</span>
                      <span class="font-semibold text-slate-800">{product.data.moq}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-slate-400">{t.products.portsLabel}:</span>
                      <span class="font-semibold text-slate-800 text-right line-clamp-1">{product.data.loadingPorts.join(' • ')}</span>
                    </div>
                  </div>
                </div>

                <!-- Action Button -->
                <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                  <a
                    href={productUrl}
                    class="flex-1 text-center py-2.5 px-3 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors"
                  >
                    {t.products.viewSpecs}
                  </a>
                  <a
                    href={rfqUrl}
                    class="flex-1 text-center py-2.5 px-3 rounded-xl text-xs font-bold text-white bg-brand-600 hover:bg-brand-700 shadow-xs transition-colors flex items-center justify-center"
                  >
                    <span>RFQ</span>
                    <span class="ml-1 text-amber-300">↗</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- "Our Features" Section (Horizon Exim 6-Pillar Core Export Strengths) -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-600 block mb-2">
          {t.features.badge}
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-['Plus_Jakarta_Sans',sans-serif]">
          {t.features.title}
        </h2>
        <p class="text-base text-slate-600 mt-3">
          {t.features.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:border-brand-500 hover:shadow-xl transition-all duration-300 group">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-5 group-hover:bg-brand-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">{t.features.f1Title}</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{t.features.f1Desc}</p>
        </div>

        <!-- Feature 2 -->
        <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:border-brand-500 hover:shadow-xl transition-all duration-300 group">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-5 group-hover:bg-brand-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">{t.features.f2Title}</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{t.features.f2Desc}</p>
        </div>

        <!-- Feature 3 -->
        <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:border-brand-500 hover:shadow-xl transition-all duration-300 group">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-5 group-hover:bg-brand-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">{t.features.f3Title}</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{t.features.f3Desc}</p>
        </div>

        <!-- Feature 4 -->
        <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:border-brand-500 hover:shadow-xl transition-all duration-300 group">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-5 group-hover:bg-brand-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">{t.features.f4Title}</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{t.features.f4Desc}</p>
        </div>

        <!-- Feature 5 -->
        <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:border-brand-500 hover:shadow-xl transition-all duration-300 group">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-5 group-hover:bg-brand-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">{t.features.f5Title}</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{t.features.f5Desc}</p>
        </div>

        <!-- Feature 6 -->
        <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 hover:border-brand-500 hover:shadow-xl transition-all duration-300 group">
          <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center font-black mb-5 group-hover:bg-brand-600 group-hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
