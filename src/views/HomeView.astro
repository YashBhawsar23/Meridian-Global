---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allProducts = await getCollection('products');
const featuredProducts = allProducts.slice(0, 3);
---

<BaseLayout
  title={t.hero.title}
  description={t.hero.subtitle}
  lang={lang}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-brand-950 via-brand-900 to-slate-900 text-white overflow-hidden py-20 lg:py-28">
    <!-- Abstract Trade Grid & World Map Background Effect -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:24px_24px]"></div>
    <div class="absolute -right-24 -bottom-24 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-24 -top-24 w-96 h-96 bg-trade-gold/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <!-- Trust Pill -->
        <div class="inline-flex items-center space-x-2 bg-brand-800/80 border border-brand-700/80 rounded-full px-4 py-1.5 text-xs font-semibold text-brand-200 mb-6 backdrop-blur-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>{t.hero.badge}</span>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white font-['Plus_Jakarta_Sans',sans-serif] mb-6">
          {t.hero.title}
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-8">
          {t.hero.subtitle}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a
            href={getLocalizedPath('/rfq', lang)}
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-slate-950 bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 hover:to-amber-200 shadow-lg shadow-amber-900/20 transition-all duration-200 hover:-translate-y-0.5"
          >
            <span>{t.hero.requestQuote}</span>
            <svg class="w-5 h-5 ml-2 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a
            href={getLocalizedPath('/products', lang)}
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-white bg-white/10 hover:bg-white/15 border border-white/20 backdrop-blur-sm transition-all duration-200 hover:-translate-y-0.5"
          >
            <span>{t.hero.viewProducts}</span>
          </a>
        </div>
      </div>

      <!-- Key Performance Indicators / Stats Bar -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-10 border-t border-slate-800">
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xs">
          <div class="text-2xl sm:text-3xl font-extrabold text-white font-['Plus_Jakarta_Sans',sans-serif]">48+</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">{t.hero.stats.countries}</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xs">
          <div class="text-2xl sm:text-3xl font-extrabold text-white font-['Plus_Jakarta_Sans',sans-serif]">250,000+</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">{t.hero.stats.volume}</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xs">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-['Plus_Jakarta_Sans',sans-serif]">100%</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">{t.hero.stats.compliance}</div>
        </div>
        <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xs">
          <div class="text-2xl sm:text-3xl font-extrabold text-amber-400 font-['Plus_Jakarta_Sans',sans-serif]">&lt; 24h</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">{t.hero.stats.turnaround}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Global Logistics Trust Badges Strip -->
  <section class="bg-white border-y border-slate-200 py-10 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-8">
        <h2 class="text-xs uppercase tracking-widest font-bold text-brand-600 mb-1">
          {t.badges.title}
        </h2>
        <p class="text-sm text-slate-500">
          {t.badges.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 items-center">
        <div class="flex items-center justify-center p-4 bg-slate-50 rounded-xl border border-slate-200/80 hover:border-brand-300 transition-colors">
          <div class="text-center">
            <span class="block text-lg font-black text-slate-800">SGS</span>
            <span class="text-[11px] font-semibold text-slate-500">{t.badges.sgs}</span>
          </div>
        </div>
        <div class="flex items-center justify-center p-4 bg-slate-50 rounded-xl border border-slate-200/80 hover:border-brand-300 transition-colors">
          <div class="text-center">
            <span class="block text-lg font-black text-slate-800">BUREAU VERITAS</span>
            <span class="text-[11px] font-semibold text-slate-500">{t.badges.bureauVeritas}</span>
          </div>
        </div>
        <div class="flex items-center justify-center p-4 bg-slate-50 rounded-xl border border-slate-200/80 hover:border-brand-300 transition-colors">
          <div class="text-center">
            <span class="block text-lg font-black text-emerald-700">ISO 22000 / 9001</span>
            <span class="text-[11px] font-semibold text-slate-500">{t.badges.iso}</span>
          </div>
        </div>
        <div class="flex items-center justify-center p-4 bg-slate-50 rounded-xl border border-slate-200/80 hover:border-brand-300 transition-colors">
          <div class="text-center">
            <span class="block text-lg font-black text-amber-700">HACCP</span>
            <span class="text-[11px] font-semibold text-slate-500">{t.badges.haccp}</span>
          </div>
        </div>
        <div class="flex items-center justify-center p-4 bg-slate-50 rounded-xl border border-slate-200/80 hover:border-brand-300 transition-colors col-span-2 md:col-span-1">
          <div class="text-center">
            <span class="block text-lg font-black text-brand-700">INCOTERMS 2020</span>
            <span class="text-[11px] font-semibold text-slate-500">{t.badges.incoterms}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Commodities Section -->
  <section class="py-16 lg:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand-600 block mb-2">
          {t.products.badge}
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif]">
          {t.products.title}
        </h2>
        <p class="text-base text-slate-600 mt-2 max-w-2xl">
          {t.products.subtitle}
        </p>
      </div>
      <div class="mt-4 md:mt-0">
        <a
          href={getLocalizedPath('/products', lang)}
          class="inline-flex items-center text-sm font-bold text-brand-700 hover:text-brand-900 group"
        >
          <span>{lang === 'es' ? 'Ver todo el catálogo' : 'View full catalog'}</span>
          <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Product Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredProducts.map((product) => {
        const productUrl = getLocalizedPath(`/products/${product.slug}`, lang);
        const rfqUrl = getLocalizedPath(`/rfq?product=${product.slug}`, lang);
        return (
          <article class="bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col overflow-hidden group">
            <!-- Product Image -->
            <div class="relative h-56 overflow-hidden bg-slate-100">
              <img
                src={product.data.featuredImage}
                alt={product.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur-xs text-white text-xs font-semibold px-2.5 py-1 rounded-md">
                HS {product.data.hsCode}
              </div>
              <div class="absolute top-3 right-3 bg-brand-600 text-white text-xs font-bold px-2.5 py-1 rounded-md shadow-xs">
                {product.data.originCountry}
              </div>
            </div>

            <!-- Card Content -->
            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-brand-600 mb-1 block">
                  {product.data.category || 'Bulk Commodity'}
                </span>
                <h3 class="text-xl font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] group-hover:text-brand-700 transition-colors">
                  <a href={productUrl}>{product.data.title}</a>
                </h3>
                <p class="text-xs text-slate-500 mt-2 line-clamp-2">
                  {product.data.metaDescription}
                </p>

                <!-- Spec Grid Tags -->
                <div class="mt-4 pt-4 border-t border-slate-100 grid grid-cols-2 gap-2 text-xs">
                  <div>
                    <span class="text-slate-400 block">{t.products.gradeLabel}:</span>
                    <span class="font-medium text-slate-800 line-clamp-1">{product.data.grade}</span>
                  </div>
                  <div>
                    <span class="text-slate-400 block">{t.products.moqLabel}:</span>
                    <span class="font-medium text-slate-800 line-clamp-1">{product.data.moq}</span>
                  </div>
                </div>

                <!-- Incoterms Badges -->
                <div class="mt-3 flex flex-wrap gap-1">
                  {product.data.incoterms.map((incoterm) => (
                    <span class="bg-slate-100 text-slate-700 text-[10px] font-semibold px-2 py-0.5 rounded">
                      {incoterm}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Card Action Buttons -->
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                <a
                  href={productUrl}
                  class="flex-1 text-center py-2 px-3 rounded-lg text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-colors"
                >
                  {t.products.viewSpecs}
                </a>
                <a
                  href={rfqUrl}
                  class="flex-1 text-center py-2 px-3 rounded-lg text-xs font-bold text-white bg-brand-700 hover:bg-brand-800 shadow-xs transition-colors"
                >
                  RFQ
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Institutional RFQ Banner Section -->
  <section class="bg-brand-950 text-white py-16 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="bg-gradient-to-r from-brand-900 to-slate-900 rounded-3xl p-8 sm:p-12 lg:p-16 border border-brand-800/80 shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="max-w-2xl">
          <span class="text-amber-400 text-xs font-bold uppercase tracking-wider block mb-2">
            Direct Trade Desk Operations
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white font-['Plus_Jakarta_Sans',sans-serif] mb-4">
            {lang === 'es'
              ? '¿Requiere precios CIF competitivos y asignación de cupo?'
              : 'Require Institutional CIF Pricing & Allocation Quotas?'}
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            {lang === 'es'
              ? 'Conecte directamente con nuestros operadores de trading para recibir contratos proforma, fletes marítimos confirmados y reportes de calidad SGS en menos de 24 horas.'
              : 'Connect directly with our physical trading desk to receive pro-forma contracts, confirmed ocean freight estimates, and recent laboratory assays within 24 hours.'}
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 shrink-0">
          <a
            href={getLocalizedPath('/rfq', lang)}
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-slate-950 bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 hover:to-amber-200 shadow-lg shadow-amber-900/30 transition-transform duration-200 hover:scale-105"
          >
            <span>{t.header.cta}</span>
            <svg class="w-5 h-5 ml-2 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
