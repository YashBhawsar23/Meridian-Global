---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={t.about.title}
  description={t.about.subtitle}
  lang={lang}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-brand-950 via-brand-900 to-slate-900 text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400 block mb-3">
          {t.about.badge}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white font-['Plus_Jakarta_Sans',sans-serif] mb-6">
          {t.about.title}
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          {t.about.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Licenses & Accreditations Section -->
  <section class="py-14 lg:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-3 py-1 rounded-full border border-brand-200">
          <span>Global Institutional Standing</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif]">
          {t.about.licensesTitle}
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          {t.about.licensesText}
        </p>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          {lang === 'es'
            ? 'Todos los contratos de suministro se ejecutan bajo marcos normativos estandarizados de la Cámara de Comercio Internacional (ICC Incoterms 2020) y las asociaciones de arbitraje comercial (GAFTA / FOSFA).'
            : 'All commercial supply agreements adhere strictly to standardized International Chamber of Commerce (ICC Incoterms 2020) guidelines and GAFTA/FOSFA arbitration frameworks.'}
        </p>

        <!-- Certifications Grid List -->
        <div class="grid grid-cols-2 gap-4 pt-4">
          <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-slate-400 uppercase block">FMC / OTI License</span>
            <span class="text-sm font-bold text-slate-900 mt-1 block">#028941N Authorized</span>
            <span class="text-xs text-slate-500 mt-0.5 block">Federal Maritime Commission</span>
          </div>
          <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-slate-400 uppercase block">EU EORI Status</span>
            <span class="text-sm font-bold text-slate-900 mt-1 block">NL849201948B01</span>
            <span class="text-xs text-slate-500 mt-0.5 block">European Customs Vetted</span>
          </div>
          <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-slate-400 uppercase block">C-TPAT Tier 3</span>
            <span class="text-sm font-bold text-slate-900 mt-1 block">Green Lane Validated</span>
            <span class="text-xs text-slate-500 mt-0.5 block">Customs-Trade Partnership</span>
          </div>
          <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-slate-400 uppercase block">ISO Governance</span>
            <span class="text-sm font-bold text-slate-900 mt-1 block">ISO 9001 &amp; 22000</span>
            <span class="text-xs text-slate-500 mt-0.5 block">Quality Management Audited</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="relative rounded-3xl overflow-hidden border border-slate-200 shadow-xl bg-slate-900">
          <img
            src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=1200&q=80"
            alt="Container terminal operations and maritime logistics"
            class="w-full h-[460px] object-cover opacity-90"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent flex flex-col justify-end p-8 text-white">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-1">
              Multi-Port Infrastructure
            </span>
            <h3 class="text-xl font-bold font-['Plus_Jakarta_Sans',sans-serif]">
              Direct Stevedoring &amp; Continuous Loading
            </h3>
            <p class="text-xs text-slate-300 mt-1">
              Contracted berths and bulk conveyor systems at Santos, Puerto Quetzal, Antofagasta, and Rotterdam.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 4-Stage Quality Control Protocol Section -->
  <section class="bg-slate-100/70 border-y border-slate-200 py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-600 block mb-2">
          {t.about.badge}
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif]">
          {t.about.inspectionProtocolTitle}
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-3">
          {t.about.inspectionProtocolSubtitle}
        </p>
      </div>

      <!-- 4 Steps Flow Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Step 1 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs relative flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 font-black flex items-center justify-center text-lg mb-4 border border-brand-200">
              01
            </div>
            <h3 class="text-base font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">
              {t.about.step1Title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {t.about.step1Desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 text-[11px] font-semibold text-brand-600 flex items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-500 mr-2"></span>
            Assay Validation
          </div>
        </div>

        <!-- Step 2 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs relative flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 font-black flex items-center justify-center text-lg mb-4 border border-brand-200">
              02
            </div>
            <h3 class="text-base font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">
              {t.about.step2Title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {t.about.step2Desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 text-[11px] font-semibold text-brand-600 flex items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-500 mr-2"></span>
            ISPM 15 Fumigated
          </div>
        </div>

        <!-- Step 3 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs relative flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-700 text-white font-black flex items-center justify-center text-lg mb-4 shadow-sm">
              03
            </div>
            <h3 class="text-base font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">
              {t.about.step3Title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {t.about.step3Desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 text-[11px] font-semibold text-emerald-600 flex items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2"></span>
            SGS / BV Port Survey
          </div>
        </div>

        <!-- Step 4 -->
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs relative flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-700 font-black flex items-center justify-center text-lg mb-4 border border-brand-200">
              04
            </div>
            <h3 class="text-base font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-2">
              {t.about.step4Title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {t.about.step4Desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 text-[11px] font-semibold text-brand-600 flex items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-500 mr-2"></span>
            Clean On Board B/L
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm max-w-3xl mx-auto">
      <h3 class="text-2xl font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-3">
        {lang === 'es' ? '¿Desea verificar nuestras credenciales y pólizas?' : 'Verify Corporate Credentials & Insurance Policies?'}
      </h3>
      <p class="text-sm text-slate-600 mb-6">
        {lang === 'es'
          ? 'Contacte con nuestra secretaría de comercio para recibir copias certificadas de nuestras licencias de exportación y certificados de trazabilidad.'
          : 'Contact our compliance officer to receive authenticated copies of export licenses, insurance binders, and traceable bill of lading samples.'}
      </p>
      <a
        href={getLocalizedPath('/rfq', lang)}
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl text-sm font-bold text-white bg-brand-700 hover:bg-brand-800 transition-colors shadow-sm"
      >
        <span>{t.header.cta}</span>
      </a>
    </div>
  </section>
</BaseLayout>
