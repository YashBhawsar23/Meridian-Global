---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, getLocalizedPath, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  product: CollectionEntry<'products'>;
  lang: SupportedLanguage;
}

const { product, lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = await product.render();

const rfqUrl = getLocalizedPath(`/rfq?product=${product.slug}`, lang);
const catalogUrl = getLocalizedPath('/products', lang);

// JSON-LD Trade Schema
const jsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.data.title,
  image: [product.data.featuredImage],
  description: product.data.metaDescription,
  sku: product.data.hsCode,
  mpn: product.data.hsCode,
  countryOfOrigin: {
    '@type': 'Country',
    name: product.data.originCountry,
  },
  brand: {
    '@type': 'Brand',
    name: 'Meridian Global Trade',
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: {
      '@type': 'Organization',
      name: 'Meridian Global Trade Corporation',
      url: 'https://example-trade.com',
    },
    eligibleQuantity: {
      '@type': 'QuantitativeValue',
      value: product.data.moq,
    },
  },
  additionalProperty: [
    {
      '@type': 'PropertyValue',
      name: 'HS Code',
      value: product.data.hsCode,
    },
    {
      '@type': 'PropertyValue',
      name: 'Grade Specification',
      value: product.data.grade,
    },
    {
      '@type': 'PropertyValue',
      name: 'Incoterms Supported',
      value: product.data.incoterms.join(', '),
    },
    {
      '@type': 'PropertyValue',
      name: 'Export Ports',
      value: product.data.loadingPorts.join(', '),
    },
    {
      '@type': 'PropertyValue',
      name: 'Certifications',
      value: product.data.certifications.join(', '),
    },
  ],
};
---

<BaseLayout
  title={`${product.data.title} - HS Code ${product.data.hsCode}`}
  description={product.data.metaDescription}
  lang={lang}
  image={product.data.featuredImage}
  ogType="product"
  schema={jsonLd}
>
  <!-- Breadcrumb & Back Navigation -->
  <section class="bg-slate-100 border-b border-slate-200 py-3.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center text-xs text-slate-500 font-medium">
        <a href={getLocalizedPath('/', lang)} class="hover:text-brand-700 transition-colors">
          {t.nav.home}
        </a>
        <span class="mx-2 text-slate-300">/</span>
        <a href={catalogUrl} class="hover:text-brand-700 transition-colors">
          {t.nav.products}
        </a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-800 font-bold truncate max-w-xs">{product.data.title}</span>
      </nav>
    </div>
  </section>

  <!-- Commodity Header & Overview Hero -->
  <section class="bg-white py-10 lg:py-16 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column: Featured Imagery -->
        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-md relative bg-slate-900 group">
            <img
              src={product.data.featuredImage}
              alt={product.data.title}
              class="w-full h-80 sm:h-96 object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute top-4 left-4 bg-slate-950/85 backdrop-blur-xs text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm">
              HS Code: {product.data.hsCode}
            </div>
            <div class="absolute top-4 right-4 bg-brand-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm">
              Origin: {product.data.originCountry}
            </div>
          </div>

          <!-- Quick Trust Badges Strip -->
          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="block text-xs font-black text-slate-900">SGS</span>
              <span class="text-[10px] text-slate-500">100% Pre-Shipment</span>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="block text-xs font-black text-slate-900">ISO</span>
              <span class="text-[10px] text-slate-500">Certified Facility</span>
            </div>
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-3">
              <span class="block text-xs font-black text-slate-900">ESCROW</span>
              <span class="text-[10px] text-slate-500">Secure L/C At Sight</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Commercial Summary & CTA -->
        <div class="lg:col-span-7 flex flex-col justify-between h-full">
          <div>
            <div class="flex items-center space-x-2 mb-2">
              <span class="text-xs font-bold uppercase tracking-wider text-brand-600">
                {product.data.category || 'Bulk Physical Commodity'}
              </span>
              <span class="text-slate-300">•</span>
              <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                Ready for Dispatch
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] leading-tight mb-4">
              {product.data.title}
            </h1>

            <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6">
              {product.data.metaDescription}
            </p>

            <!-- Key Commercial Highlights Box -->
            <div class="bg-slate-50 rounded-2xl border border-slate-200/90 p-5 mb-8">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                <div>
                  <span class="text-slate-400 font-medium block">{t.products.gradeLabel}</span>
                  <span class="text-slate-900 font-bold text-sm">{product.data.grade}</span>
                </div>
                <div>
                  <span class="text-slate-400 font-medium block">{t.products.moqLabel}</span>
                  <span class="text-slate-900 font-bold text-sm">{product.data.moq}</span>
                </div>
                <div>
                  <span class="text-slate-400 font-medium block">{t.products.incotermsLabel}</span>
                  <span class="text-slate-900 font-semibold">{product.data.incoterms.join(', ')}</span>
                </div>
                <div>
                  <span class="text-slate-400 font-medium block">{t.products.portsLabel}</span>
                  <span class="text-slate-900 font-semibold">{product.data.loadingPorts.join(' / ')}</span>
                </div>
              </div>
            </div>

            <!-- Certifications Chips -->
            <div class="mb-8">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">
                {t.products.certificationsLabel}
              </span>
              <div class="flex flex-wrap gap-2">
                {product.data.certifications.map((cert) => (
                  <span class="inline-flex items-center text-xs font-semibold px-3 py-1 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200/80">
                    <svg class="w-3.5 h-3.5 mr-1.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    {cert}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Prominent RFQ Action Box -->
          <div class="p-6 rounded-2xl bg-gradient-to-r from-brand-900 to-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
            <div>
              <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-0.5">
                B2B Commercial Inquiries
              </div>
              <div class="text-lg font-bold">
                {t.productDetail.instantRFQTitle}
              </div>
            </div>
            <a
              href={rfqUrl}
              class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 hover:to-amber-200 shadow-md transition-all hover:scale-105"
            >
              <span>{t.productDetail.rfqButton}</span>
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Technical Specification Table & Content Details -->
  <section class="py-14 lg:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Content / Markdown Area -->
      <div class="lg:col-span-8">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
          <h2 class="text-2xl font-extrabold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-6 pb-4 border-b border-slate-100 flex items-center">
            <svg class="w-6 h-6 text-brand-600 mr-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            {t.productDetail.specificationsTitle}
          </h2>

          <!-- Comprehensive Trade Parameter Matrix -->
          <div class="overflow-x-auto mb-10 rounded-xl border border-slate-200">
            <table class="min-w-full divide-y divide-slate-200 text-xs sm:text-sm text-left">
              <thead class="bg-slate-100 text-slate-700 font-bold uppercase tracking-wider text-[11px]">
                <tr>
                  <th scope="col" class="py-3 px-4">Export Parameter</th>
                  <th scope="col" class="py-3 px-4">Commercial Specification</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 bg-white">
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/50">Harmonized System (HS) Code</td>
                  <td class="py-3 px-4 text-slate-900 font-mono font-bold">{product.data.hsCode}</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/50">Country of Origin</td>
                  <td class="py-3 px-4 text-slate-900 font-bold">{product.data.originCountry}</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/50">Quality Grade / Assay Standard</td>
                  <td class="py-3 px-4 text-slate-900">{product.data.grade}</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/50">Minimum Order Quantity (MOQ)</td>
                  <td class="py-3 px-4 text-slate-900 font-semibold">{product.data.moq}</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/50">Incoterms (ICC 2020)</td>
                  <td class="py-3 px-4 text-slate-900">{product.data.incoterms.join(', ')}</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/50">Authorized Loading Ports</td>
                  <td class="py-3 px-4 text-slate-900">{product.data.loadingPorts.join(' • ')}</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/50">Export Packaging Options</td>
                  <td class="py-3 px-4 text-slate-900">
                    <ul class="list-disc list-inside space-y-1">
                      {product.data.packaging.map((pack) => (
                        <li>{pack}</li>
                      ))}
                    </ul>
                  </td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/50">Quality Certifications</td>
                  <td class="py-3 px-4 text-slate-900">{product.data.certifications.join(', ')}</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Markdown Content Render with Markdown Table Styles -->
          <div class="prose prose-slate max-w-none text-slate-700 text-sm leading-relaxed prose-headings:font-['Plus_Jakarta_Sans',sans-serif] prose-headings:text-slate-900 prose-headings:font-bold prose-table:border prose-table:border-slate-200 prose-table:text-xs sm:prose-table:text-sm prose-th:bg-slate-100 prose-th:p-3 prose-td:p-3 prose-td:border-t prose-td:border-slate-100 overflow-x-auto">
            <Content />
          </div>
        </div>
      </div>

      <!-- Right Sidebar: Inspection & Logistics Details -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Inspection Assurance Card -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
          <h3 class="text-base font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-4 flex items-center">
            <svg class="w-5 h-5 text-emerald-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            Pre-Shipment Inspection
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Independent surveyors (SGS / Bureau Veritas) inspect this commodity at loading port:
          </p>
          <ul class="text-xs text-slate-600 space-y-2 mb-6">
            <li class="flex items-start">
              <span class="text-emerald-500 font-bold mr-2">✓</span>
              <span>100% Verified Weight and Draft Survey Certificate</span>
            </li>
            <li class="flex items-start">
              <span class="text-emerald-500 font-bold mr-2">✓</span>
              <span>Complete Chemical &amp; Microbiological Assay Report</span>
            </li>
            <li class="flex items-start">
              <span class="text-emerald-500 font-bold mr-2">✓</span>
              <span>Container Seal Numbers explicitly noted on Bill of Lading</span>
            </li>
          </ul>
          <a
            href={rfqUrl}
            class="block w-full text-center py-2.5 px-4 rounded-xl text-xs font-bold text-brand-700 bg-brand-50 hover:bg-brand-100 border border-brand-200 transition-colors"
          >
            Request Sample / Assay Report
          </a>
        </div>

        <!-- Shipping & Escrow Box -->
        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
          <h3 class="text-base font-bold text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] mb-3">
            Banking &amp; Settlement
          </h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            Payment structures accommodated for qualified institutional buyers:
          </p>
          <div class="space-y-2 text-xs">
            <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/80">
              <strong class="text-slate-800 block">Letter of Credit (L/C):</strong>
              <span class="text-slate-500">Irrevocable, Confirmed at Sight (Top 50 Prime World Banks).</span>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/80">
              <strong class="text-slate-800 block">Documentary Collection (CAD):</strong>
              <span class="text-slate-500">Bank-to-bank collection against full shipping documentation.</span>
            </div>
            <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200/80">
              <strong class="text-slate-800 block">Telegraphic Transfer (T/T):</strong>
              <span class="text-slate-500">Advance deposit with balance against non-negotiable B/L copy.</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
