---
import { useTranslations, getLocalizedPath, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);

const navLinks = [
  { href: getLocalizedPath('/', currentLang), label: t.nav.home },
  { href: getLocalizedPath('/products', currentLang), label: t.nav.products },
  { href: getLocalizedPath('/capabilities', currentLang), label: t.nav.capabilities },
  { href: getLocalizedPath('/about', currentLang), label: t.nav.about },
  { href: getLocalizedPath('/rfq', currentLang), label: t.nav.rfq },
];

const whatsAppMsg = encodeURIComponent(
  currentLang === 'es'
    ? 'Hola, deseo solicitar cotización formal (RFQ) para commodities de exportación.'
    : 'Hello, I would like to request an institutional export commodity RFQ.'
);
const whatsAppUrl = `https://wa.me/18005489120?text=${whatsAppMsg}`;
---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800 relative">
  <!-- Accreditation Badges Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-14">
    <div class="bg-slate-800/80 rounded-2xl p-6 border border-slate-700/60 shadow-inner">
      <div class="text-center mb-6">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-400">
          International Trade Accreditation &amp; Governance
        </span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 items-center text-center">
        <!-- SGS -->
        <div class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 border border-slate-700">
          <span class="text-lg font-black tracking-wider text-white">SGS</span>
          <span class="text-[11px] text-slate-400 mt-1 font-medium">Assay &amp; Weight Certified</span>
        </div>
        <!-- Bureau Veritas -->
        <div class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 border border-slate-700">
          <span class="text-lg font-black tracking-wider text-white">BUREAU VERITAS</span>
          <span class="text-[11px] text-slate-400 mt-1 font-medium">Marine Pre-Shipment Audit</span>
        </div>
        <!-- ISO 22000 & 9001 -->
        <div class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 border border-slate-700">
          <span class="text-lg font-black tracking-wider text-emerald-400">ISO 9001 / 22000</span>
          <span class="text-[11px] text-slate-400 mt-1 font-medium">Quality Management System</span>
        </div>
        <!-- HACCP -->
        <div class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 border border-slate-700">
          <span class="text-lg font-black tracking-wider text-amber-400">HACCP</span>
          <span class="text-[11px] text-slate-400 mt-1 font-medium">Food Safety Protocols</span>
        </div>
        <!-- Incoterms 2020 -->
        <div class="flex flex-col items-center justify-center p-3 rounded-xl bg-slate-900/60 border border-slate-700 col-span-2 sm:col-span-1">
          <span class="text-lg font-black tracking-wider text-brand-300">INCOTERMS 2020</span>
          <span class="text-[11px] text-slate-400 mt-1 font-medium">ICC Standard Contracts</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Company Bio & Identity -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-brand-700 text-white flex items-center justify-center shadow-md">
            <svg class="w-6 h-6 text-brand-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
              <path d="M2 12h20"></path>
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight text-white font-['Plus_Jakarta_Sans',sans-serif]">
            MERIDIAN<span class="text-brand-400">TRADE</span>
          </span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {t.footer.aboutText}
        </p>
        <div class="text-xs text-slate-400 space-y-1 pt-2">
          <div><strong class="text-slate-300">Registration:</strong> US DOT / FMC FMC-OTI #028941N</div>
          <div><strong class="text-slate-300">EORI Number:</strong> NL849201948B01</div>
          <div><strong class="text-slate-300">DUNS Number:</strong> 83-920-4102</div>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">
          {t.footer.quickLinks}
        </h4>
        <ul class="space-y-2.5 text-sm">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-slate-400 hover:text-brand-400 transition-colors flex items-center group"
              >
                <span class="text-brand-500 mr-2 group-hover:translate-x-1 transition-transform">›</span>
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a
              href={getLocalizedPath('/rfq', currentLang)}
              class="text-brand-400 hover:text-brand-300 font-semibold transition-colors flex items-center group"
            >
              <span class="text-brand-400 mr-2 group-hover:translate-x-1 transition-transform">›</span>
              {t.header.cta}
            </a>
          </li>
        </ul>
      </div>

      <!-- Compliance & Protocols -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">
          {t.footer.tradeCompliance}
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li class="flex items-start">
            <svg class="w-4 h-4 text-emerald-400 mr-2 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>Pre-shipment sampling and testing by accredited independent laboratories (SGS / BV).</span>
          </li>
          <li class="flex items-start">
            <svg class="w-4 h-4 text-emerald-400 mr-2 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>Clean on Board Bills of Lading and phytosanitary certificates compliant with USDA / EU EFSA.</span>
          </li>
          <li class="flex items-start">
            <svg class="w-4 h-4 text-emerald-400 mr-2 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>Secure financial escrow, standby letters of credit (SBLC), and Documentary Collections (CAD).</span>
          </li>
        </ul>
      </div>

      <!-- Trade Desk Contacts -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-white mb-4">
          {t.footer.contactInfo}
        </h4>
        <div class="space-y-3 text-xs text-slate-400">
          <p>
            <strong class="text-slate-200">Global Operations Hub:</strong><br />
            Harborside Trade Center, Suite 1400<br />
            Miami, FL 33132, United States
          </p>
          <p>
            <strong class="text-slate-200">European Regional Desk:</strong><br />
            Willemskade 22, Port of Rotterdam<br />
            3016 DL Rotterdam, Netherlands
          </p>
          <p class="pt-1">
            <strong class="text-slate-200">Direct Inquiries:</strong><br />
            <a href="mailto:trade@meridian-trade.com" class="text-brand-400 hover:underline">trade@meridian-trade.com</a><br />
            <span class="text-slate-300">+1 (800) 548-9120 (Mon-Fri 24h)</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Legal Notice & Copyright -->
    <div class="border-t border-slate-800 pt-8 mt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p class="text-center md:text-left">
        &copy; {new Date().getFullYear()} Meridian Global Trade Corporation. {t.footer.copyright}
      </p>
      <p class="text-center md:text-right max-w-xl text-[11px] text-slate-500">
        {t.footer.disclaimer}
      </p>
    </div>
  </div>

  <!-- Floating WhatsApp Contact Button -->
  <aside aria-label="WhatsApp live contact" class="fixed bottom-6 right-6 z-40">
    <a
      href={whatsAppUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center space-x-2 bg-[#25D366] hover:bg-[#20ba59] text-white px-4 py-3 rounded-full shadow-lg shadow-emerald-950/20 hover:shadow-emerald-600/30 transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-4 focus:ring-emerald-300"
      aria-label="Direct WhatsApp Trade Desk contact"
    >
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.599 2.679-.702c.97.527 1.77.814 2.781.815 3.179 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.768-5.768-5.768zm0 10.364c-.878 0-1.74-.235-2.493-.681l-.179-.106-1.854.486.495-1.808-.117-.186c-.49-.781-.749-1.689-.748-2.618 0-2.535 2.062-4.597 4.598-4.597 2.534 0 4.596 2.062 4.597 4.597 0 2.536-2.062 4.598-4.598 4.598zm2.52-3.447c-.138-.07-.818-.404-.945-.45-.127-.046-.22-.07-.312.07-.093.138-.358.45-.44.542-.08.093-.162.104-.3.035-.138-.07-.584-.215-1.112-.686-.411-.366-.689-.818-.77-957-.08-.138-.009-.213.06-.282.063-.062.138-.162.207-.243.07-.08.092-.138.138-.23.046-.093.023-.173-.012-.243-.035-.07-.312-.751-.428-1.028-.112-.269-.226-.233-.312-.237l-.265-.005c-.093 0-.243.035-.37.173-.127.138-.484.473-.484 1.154 0 .681.496 1.339.565 1.431.07.093.977 1.492 2.366 2.092.331.143.59.228.792.292.333.106.636.091.876.055.267-.04.818-.334.933-.658.115-.323.115-.601.08-.658-.034-.058-.126-.093-.264-.162z"/>
        <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.435 5.177L2 22l4.98-1.396A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2c-1.637 0-3.17-.468-4.477-1.28l-.321-.2-2.964.83.844-2.89-.22-.351A8.175 8.175 0 0 1 3.8 12c0-4.521 3.679-8.2 8.2-8.2 4.522 0 8.2 3.679 8.2 8.2 0 4.522-3.678 8.2-8.2 8.2z"/>
      </svg>
      <span class="text-xs font-bold tracking-wide hidden sm:inline whitespace-nowrap">
        {t.footer.whatsappBtn}
      </span>
    </a>
  </aside>
</footer>
