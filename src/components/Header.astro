---
import { useTranslations, getLocalizedPath, type SupportedLanguage } from '../i18n/utils';

export interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const pathname = Astro.url.pathname;

const navLinks = [
  { href: getLocalizedPath('/', currentLang), label: t.nav.home },
  { href: getLocalizedPath('/products', currentLang), label: t.nav.products },
  { href: getLocalizedPath('/capabilities', currentLang), label: t.nav.capabilities },
  { href: getLocalizedPath('/about', currentLang), label: t.nav.about },
];

const rfqHref = getLocalizedPath('/rfq', currentLang);
const englishHref = getLocalizedPath(pathname, 'en');
const spanishHref = getLocalizedPath(pathname, 'es');
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs transition-all duration-200">
  <!-- Top Utility Notice Bar -->
  <div class="bg-brand-950 text-slate-300 text-xs py-1.5 px-4 hidden md:block">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-6">
        <span class="inline-flex items-center text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 mr-2 animate-pulse"></span>
          {t.header.tagline}
        </span>
        <span class="text-slate-400">|</span>
        <span class="text-slate-400">SGS &amp; BV Pre-Shipment Assayed</span>
      </div>
      <div class="flex items-center space-x-4 text-slate-300">
        <span class="inline-flex items-center">
          <svg class="w-3.5 h-3.5 mr-1 text-trade-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          +1 (800) 548-9120
        </span>
        <span class="text-slate-400">|</span>
        <span>desk@meridian-trade.com</span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={getLocalizedPath('/', currentLang)} class="flex items-center space-x-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-900 to-brand-700 text-white flex items-center justify-center shadow-md shadow-brand-900/10 group-hover:scale-105 transition-transform duration-200">
          <svg class="w-6 h-6 text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
            <path d="M2 12h20"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-tight text-slate-900 font-['Plus_Jakarta_Sans',sans-serif]">
            MERIDIAN<span class="text-brand-600">TRADE</span>
          </span>
          <span class="text-[10px] uppercase tracking-widest font-semibold text-slate-500">
            Global Import • Export B2B
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center space-x-1">
        {navLinks.map((link) => {
          const isActive = pathname === link.href || (link.href !== '/' && link.href !== '/es' && pathname.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
                isActive
                  ? 'text-brand-700 bg-brand-50/80 font-semibold'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Language Switcher & CTAs (Desktop) -->
      <div class="hidden lg:flex items-center space-x-4">
        <!-- Language Switcher Pill -->
        <div class="flex items-center bg-slate-100 border border-slate-200 p-0.5 rounded-lg text-xs font-semibold">
          <a
            href={englishHref}
            class={`px-2.5 py-1 rounded-md transition-all ${
              currentLang === 'en'
                ? 'bg-white text-brand-900 shadow-xs font-bold'
                : 'text-slate-500 hover:text-slate-900'
            }`}
            aria-label="Switch to English"
          >
            EN
          </a>
          <a
            href={spanishHref}
            class={`px-2.5 py-1 rounded-md transition-all ${
              currentLang === 'es'
                ? 'bg-white text-brand-900 shadow-xs font-bold'
                : 'text-slate-500 hover:text-slate-900'
            }`}
            aria-label="Cambiar a Español"
          >
            ES
          </a>
        </div>

        <!-- Prominent RFQ CTA Button -->
        <a
          href={rfqHref}
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-bold text-white bg-brand-700 hover:bg-brand-800 focus:ring-4 focus:ring-brand-200 shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5"
        >
          <span>{t.header.cta}</span>
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex lg:hidden items-center space-x-3">
        <!-- Compact Language Switcher on Mobile Header -->
        <div class="flex items-center bg-slate-100 border border-slate-200 p-0.5 rounded-lg text-xs font-semibold">
          <a
            href={englishHref}
            class={`px-2 py-0.5 rounded ${currentLang === 'en' ? 'bg-white text-brand-900 shadow-xs font-bold' : 'text-slate-500'}`}
          >
            EN
          </a>
          <a
            href={spanishHref}
            class={`px-2 py-0.5 rounded ${currentLang === 'es' ? 'bg-white text-brand-900 shadow-xs font-bold' : 'text-slate-500'}`}
          >
            ES
          </a>
        </div>

        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="p-2.5 rounded-lg text-slate-700 hover:text-brand-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-colors"
        >
          <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu (Hidden by default) -->
  <div
    id="mobile-drawer"
    class="lg:hidden hidden fixed inset-x-0 top-20 bottom-0 bg-slate-900/60 backdrop-blur-sm z-40 transition-opacity"
  >
    <div class="bg-white border-b border-slate-200 p-6 shadow-xl max-h-[85vh] overflow-y-auto">
      <nav class="flex flex-col space-y-3 mb-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-4 py-3 rounded-lg text-base font-semibold text-slate-800 hover:text-brand-700 hover:bg-brand-50 transition-colors flex items-center justify-between"
          >
            <span>{link.label}</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        ))}
      </nav>

      <!-- Language selector inside drawer -->
      <div class="border-t border-slate-100 pt-4 mb-6">
        <label class="block text-xs uppercase tracking-wider font-bold text-slate-400 mb-2">
          Language / Idioma
        </label>
        <div class="grid grid-cols-2 gap-2">
          <a
            href={englishHref}
            class={`text-center py-2.5 px-4 rounded-lg font-medium text-sm border ${
              currentLang === 'en'
                ? 'border-brand-600 bg-brand-50 text-brand-800 font-bold'
                : 'border-slate-200 text-slate-700 hover:bg-slate-50'
            }`}
          >
            English (EN)
          </a>
          <a
            href={spanishHref}
            class={`text-center py-2.5 px-4 rounded-lg font-medium text-sm border ${
              currentLang === 'es'
                ? 'border-brand-600 bg-brand-50 text-brand-800 font-bold'
                : 'border-slate-200 text-slate-700 hover:bg-slate-50'
            }`}
          >
            Español (ES)
          </a>
        </div>
      </div>

      <!-- Prominent Mobile CTA Button -->
      <a
        href={rfqHref}
        class="w-full inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-base font-bold text-white bg-brand-700 hover:bg-brand-800 shadow-md shadow-brand-800/20 transition-all text-center"
      >
        <span>{t.header.cta}</span>
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggleBtn || !drawer) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());

      if (isExpanded) {
        drawer.classList.add('hidden');
        hamburgerIcon?.classList.remove('hidden');
        hamburgerIcon?.classList.add('block');
        closeIcon?.classList.remove('block');
        closeIcon?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      } else {
        drawer.classList.remove('hidden');
        hamburgerIcon?.classList.remove('block');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        closeIcon?.classList.add('block');
        document.body.classList.add('overflow-hidden');
      }
    });

    // Close menu when clicking backdrop
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) {
        drawer.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        hamburgerIcon?.classList.remove('hidden');
        hamburgerIcon?.classList.add('block');
        closeIcon?.classList.remove('block');
        closeIcon?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }
    });
  }

  // Run on initial load and after view transitions
  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
