---
import HomeView from '../../views/HomeView.astro';
import type { SupportedLanguage } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<HomeView lang={lang} />
