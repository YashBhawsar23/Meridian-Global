---
import CapabilitiesView from '../../views/CapabilitiesView.astro';
import { supportedLocales } from '../../i18n/utils';
import type { SupportedLanguage } from '../../i18n/translations';

export function getStaticPaths() {
  return supportedLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<CapabilitiesView lang={lang} />
