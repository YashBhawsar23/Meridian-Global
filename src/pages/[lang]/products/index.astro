---
import ProductsView from '../../../views/ProductsView.astro';
import { supportedLocales } from '../../../i18n/utils';
import type { SupportedLanguage } from '../../../i18n/translations';

export function getStaticPaths() {
  return supportedLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
---

<ProductsView lang={lang} />
